class Solution {
    public int lengthOfLongestSubstring(String s) {
        int[] arr = new int[100];
        Arrays.fill(arr, -1);
        int n = s.length();
        if (s == null || n == 0) {
            return 0;
        }
        int max = 0;
        int slow = 0;
        for (int i = 0; i < n; i++) {
            char ch = s.charAt(i);
            if (arr[ch - ' '] != -1) {
                slow = Math.max(slow, arr[ch - ' '] + 1);
            } 
                arr[ch - ' '] = i;
            

            max = Math.max(max, i - slow + 1);

        }
        return max;

    }
}