class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashMap<Character,Integer> myMap = new HashMap<>(); //to store charecter and corresponding indices from string
        int n = s.length();
        if (s == null || n == 0) { //null case checking
            return 0;
        }
        int max = 0;
        int slow = 0; //slow pointer
        for (int i = 0; i < n; i++) { //fast pointer
            char ch = s.charAt(i);
            if (myMap.containsKey(ch)) { //if map contains ch moving slow pointer by taking max between slow and myMap.get(ch)+1
                  slow=Math.max(slow,myMap.get(ch)+1);
            }
            myMap.put(ch,i); //if ch not exist adding ch to hash,ap with indices
            max = Math.max(max, i - slow + 1); //fining max substring among all possibilities

        }
        return max;

    }
}

