// Your code here along with comments explaining your approach:
class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashSet<Character> mySet = new HashSet<>(); //to store char from string which we are looping 
        int n = s.length();
        if (s == null || n == 0) {//null case checking
            return 0;
        }
        int max = 0;
        int slow = 0; //slow pointer
        for (int i = 0; i < n; i++) { //fast pointer as i
            char ch = s.charAt(i);
            if (mySet.contains(ch)) { //if ch already exist in hashset it means duplicate occures in sr=tring need to avoid 
                while (s.charAt(slow) != ch) { //to avoid duplicate char moving slow pointer after duplicate char index
                    mySet.remove(s.charAt(slow)); //removing each slow char from hashset
                    slow++; 
                }
                slow++; //have to escape duplicate char as well
            }
            mySet.add(ch); //if it does not exist just adding to hashset
            max = Math.max(max, i - slow + 1); //finding max substring length among all possiblities

        }
        return max;

    }
}


